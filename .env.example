# LLM Pipeline Generator — environment configuration
#
# Copy this file to `.env` (in the same directory) and fill in real values.
# Both the worker (agent-worker) and the API (agent-api) read
# this file at startup. Variables with the AGENT_WORKER_ prefix go to the
# worker; AGENT_API_ goes to the API server.

# ============================================================================
# Provider selection
# ============================================================================
# Which LLM the API routes jobs to when no mock_script_path is supplied.
# Values: claude | gemini | mock
AGENT_API_LLM_PROVIDER=claude

# ============================================================================
# Claude (Anthropic)
# ============================================================================
# Either of the two keys below works. The worker checks
# AGENT_WORKER_CLAUDE_API_KEY first; otherwise the Anthropic SDK picks up
# ANTHROPIC_API_KEY automatically.
ANTHROPIC_API_KEY=
# AGENT_WORKER_CLAUDE_API_KEY=

# Model. Default is claude-opus-4-7 (most capable).
# Cost-sensitive alternatives: claude-sonnet-4-6 ($3/$15 per 1M),
#                              claude-haiku-4-5  ($1/$5  per 1M).
AGENT_WORKER_CLAUDE_MODEL=claude-opus-4-7

# Effort level: low | medium | high | xhigh (Opus 4.7 only) | max (Opus tier)
# `high` is the recommended default for intelligence-sensitive work.
# `xhigh` is best for coding/agentic loops on Opus 4.7.
AGENT_WORKER_CLAUDE_EFFORT=high

# Per-call max output tokens. 16000 is a safe non-streaming default.
AGENT_WORKER_CLAUDE_MAX_TOKENS=16000

# ============================================================================
# Gemini (Google) — only used when AGENT_API_LLM_PROVIDER=gemini
# ============================================================================
AGENT_WORKER_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
AGENT_WORKER_GEMINI_API_KEY=
AGENT_WORKER_GEMINI_MODEL=gemini-2.5-pro
AGENT_WORKER_GEMINI_TEMPERATURE=0.1
AGENT_WORKER_GEMINI_MAX_OUTPUT_TOKENS=8192

# ============================================================================
# API server
# ============================================================================
# Where the API lands per-job workspaces. Must be writable; created on demand.
AGENT_API_WORKSPACE_ROOT=/tmp/agent-api-workspaces

# Path to the worker's bundled skills/ folder. If empty, the API auto-locates
# it via the installed agent_worker package.
# AGENT_API_SKILLS_ROOT=

# CORS origins for the frontend (Vite dev server defaults to :5173)
# AGENT_API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Log level: DEBUG | INFO | WARNING | ERROR
AGENT_API_LOG_LEVEL=INFO

# Max concurrent jobs the API runs in its thread pool.
AGENT_API_MAX_CONCURRENT_JOBS=4

# Optional: a server-local mock-responses.json that's used whenever a job
# request omits mock_script_path. Useful for demos without real LLM creds.
# AGENT_API_DEFAULT_MOCK_SCRIPT_PATH=

# ============================================================================
# Worker — token budget per job (hard cap)
# ============================================================================
AGENT_WORKER_MAX_TOKENS_PER_JOB=500000

# ============================================================================
# Optional: deeper integration (Postgres, MinIO, Bitbucket) — not used yet
# ============================================================================
# AGENT_WORKER_POSTGRES_DSN=postgresql+psycopg://agent:agent@localhost:5432/agent_worker
# AGENT_WORKER_REDIS_URL=redis://localhost:6379/0
# AGENT_WORKER_MINIO_ENDPOINT=http://localhost:9000
# AGENT_WORKER_MINIO_ACCESS_KEY=
# AGENT_WORKER_MINIO_SECRET_KEY=
# AGENT_WORKER_BITBUCKET_BASE_URL=https://bitbucket.example.com
# AGENT_WORKER_BITBUCKET_SERVICE_ACCOUNT_TOKEN=
