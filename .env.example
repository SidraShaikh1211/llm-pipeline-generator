# Saturn Agent — environment configuration
#
# Copy this file to `.env` (in the same directory) and fill in real values.
# Both the worker (saturn-agent-worker) and the API (saturn-agent-api) read
# this file at startup. Variables with the SATURN_AGENT_ prefix go to the
# worker; SATURN_API_ goes to the API server.

# ============================================================================
# Provider selection
# ============================================================================
# Which LLM the API routes jobs to when no mock_script_path is supplied.
# Values: claude | gemini | mock
SATURN_API_LLM_PROVIDER=claude

# ============================================================================
# Claude (Anthropic)
# ============================================================================
# Either of the two keys below works. The worker checks
# SATURN_AGENT_CLAUDE_API_KEY first; otherwise the Anthropic SDK picks up
# ANTHROPIC_API_KEY automatically.
ANTHROPIC_API_KEY=
# SATURN_AGENT_CLAUDE_API_KEY=

# Model. Default is claude-opus-4-7 (most capable).
# Cost-sensitive alternatives: claude-sonnet-4-6 ($3/$15 per 1M),
#                              claude-haiku-4-5  ($1/$5  per 1M).
SATURN_AGENT_CLAUDE_MODEL=claude-opus-4-7

# Effort level: low | medium | high | xhigh (Opus 4.7 only) | max (Opus tier)
# `high` is the recommended default for intelligence-sensitive work.
# `xhigh` is best for coding/agentic loops on Opus 4.7.
SATURN_AGENT_CLAUDE_EFFORT=high

# Per-call max output tokens. 16000 is a safe non-streaming default.
SATURN_AGENT_CLAUDE_MAX_TOKENS=16000

# ============================================================================
# Gemini (Google) — only used when SATURN_API_LLM_PROVIDER=gemini
# ============================================================================
SATURN_AGENT_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
SATURN_AGENT_GEMINI_API_KEY=
SATURN_AGENT_GEMINI_MODEL=gemini-2.5-pro
SATURN_AGENT_GEMINI_TEMPERATURE=0.1
SATURN_AGENT_GEMINI_MAX_OUTPUT_TOKENS=8192

# ============================================================================
# API server
# ============================================================================
# Where the API lands per-job workspaces. Must be writable; created on demand.
SATURN_API_WORKSPACE_ROOT=/tmp/saturn-api-workspaces

# Path to the worker's bundled skills/ folder. If empty, the API auto-locates
# it via the installed saturn_agent package.
# SATURN_API_SKILLS_ROOT=

# CORS origins for the frontend (Vite dev server defaults to :5173)
# SATURN_API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Log level: DEBUG | INFO | WARNING | ERROR
SATURN_API_LOG_LEVEL=INFO

# Max concurrent jobs the API runs in its thread pool.
SATURN_API_MAX_CONCURRENT_JOBS=4

# Optional: a server-local mock-responses.json that's used whenever a job
# request omits mock_script_path. Useful for demos without real LLM creds.
# SATURN_API_DEFAULT_MOCK_SCRIPT_PATH=

# ============================================================================
# Worker — token budget per job (hard cap)
# ============================================================================
SATURN_AGENT_MAX_TOKENS_PER_JOB=500000

# ============================================================================
# Optional: deeper integration (Postgres, MinIO, Bitbucket) — not used yet
# ============================================================================
# SATURN_AGENT_POSTGRES_DSN=postgresql+psycopg://saturn:saturn@localhost:5432/saturn_agent
# SATURN_AGENT_REDIS_URL=redis://localhost:6379/0
# SATURN_AGENT_MINIO_ENDPOINT=http://localhost:9000
# SATURN_AGENT_MINIO_ACCESS_KEY=
# SATURN_AGENT_MINIO_SECRET_KEY=
# SATURN_AGENT_BITBUCKET_BASE_URL=https://bitbucket.example.com
# SATURN_AGENT_BITBUCKET_SERVICE_ACCOUNT_TOKEN=
